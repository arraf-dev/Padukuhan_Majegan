// Skema Bab 8 PRD. Nama tabel & kolom memakai snake_case Indonesia lewat @map
// supaya perangkat desa yang kelak membuka Neon console mengenali isinya.
//
// Galeri kegiatan memakai album + foto agar dokumentasi dapat dikelola per
// kegiatan, bukan sebagai daftar gambar yang tidak memiliki konteks.

generator client {
  provider = "prisma-client-js"
}

// URL koneksi ada di prisma.config.ts (Prisma 7 tidak lagi menerimanya di sini).
datasource db {
  provider = "postgresql"
}

enum Peran {
  superadmin
  admin
}

enum StatusBerita {
  draft
  terbit
}

enum StatusGaleri {
  draft
  terbit
}

enum KategoriPotensi {
  pariwisata
  umkm
  budaya
}

enum StatusPotensi {
  draft
  terbit
}

enum JenisAnggaran {
  pendapatan
  belanja
  pembiayaan
}

enum KategoriStatistik {
  ringkasan
  jenis_kelamin
  usia
  pekerjaan
  pendidikan
}

model Pengguna {
  id         String   @id @default(cuid())
  nama       String
  email      String   @unique
  sandiHash  String   @map("password_hash")
  peran      Peran    @default(admin)
  jabatan    String?
  aktif      Boolean  @default(true) @map("is_active")
  dibuatPada DateTime @default(now()) @map("created_at")

  berita Berita[]

  @@map("pengguna")
}

/// Konten statis profil desa: sejarah, visi-misi, dsb.
model HalamanProfil {
  id             String   @id @default(cuid())
  slug           String   @unique
  judul          String
  konten         String
  /// Ditandai draft selama rumusannya belum disepakati musyawarah dusun.
  draft          Boolean  @default(false)
  diperbaruiPada DateTime @updatedAt @map("updated_at")

  @@map("halaman_profil")
}

model PerangkatDesa {
  id      String  @id @default(cuid())
  nama    String
  jabatan String
  fotoUrl String? @map("foto_url")
  urutan  Int     @default(0)

  @@map("perangkat_desa")
}

model KategoriBerita {
  id     String   @id @default(cuid())
  nama   String
  slug   String   @unique
  berita Berita[]

  @@map("kategori_berita")
}

model Berita {
  id           String       @id @default(cuid())
  judul        String
  slug         String       @unique
  ringkasan    String
  /// Paragraf badan berita, dipisah baris kosong.
  konten       String
  gambarSampul String?      @map("gambar_sampul")
  lokasi       String?
  status       StatusBerita @default(draft)
  suka         Int          @default(0)
  tanggapan    Int          @default(0)
  terbitPada   DateTime?    @map("published_at")
  dibuatPada   DateTime     @default(now()) @map("created_at")

  kategoriId String         @map("kategori_id")
  kategori   KategoriBerita @relation(fields: [kategoriId], references: [id])
  penulisId  String?        @map("penulis_id")
  penulis    Pengguna?      @relation(fields: [penulisId], references: [id], onDelete: SetNull)

  @@index([status, terbitPada])
  @@map("berita")
}

model AlbumGaleri {
  id              String       @id @default(cuid())
  judul           String
  slug            String       @unique
  deskripsi       String?
  kategori        String
  coverUrl        String?      @map("cover_url")
  tanggalKegiatan DateTime     @map("tanggal_kegiatan")
  status          StatusGaleri @default(draft)
  potensiId       String?      @unique @map("potensi_id")
  dibuatPada      DateTime     @default(now()) @map("created_at")
  diperbaruiPada  DateTime     @updatedAt @map("updated_at")

  foto FotoGaleri[]
  potensi Potensi? @relation(fields: [potensiId], references: [id], onDelete: SetNull)

  @@index([status, tanggalKegiatan])
  @@index([kategori])
  @@map("galeri_album")
}

model FotoGaleri {
  id         String      @id @default(cuid())
  albumId    String      @map("album_id")
  url        String
  alt        String
  caption    String?
  urutan     Int         @default(0)
  width      Int?
  height     Int?
  size       Int?
  dibuatPada DateTime    @default(now()) @map("created_at")
  album      AlbumGaleri @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, urutan])
  @@map("galeri_foto")
}

model PotensiKategori {
  id          String          @id @default(cuid())
  kode        KategoriPotensi @unique
  label       String
  judul       String
  pengantar   String
  deskripsi   String
  gambarUrl   String?         @map("gambar_url")
  urutan      Int             @default(0)
  potensi     Potensi[]
  infografis  PotensiInfografis[]

  @@map("potensi_kategori")
}

model Potensi {
  id           String          @id @default(cuid())
  kategoriId   String          @map("kategori_id")
  judul        String
  slug         String          @unique
  ringkasan    String
  deskripsi    String
  gambarUrl    String?         @map("gambar_url")
  subkategori  String?
  produk       String?
  lokasi       String?
  kontak       String?
  status       StatusPotensi   @default(draft)
  urutan       Int             @default(0)
  dibuatPada   DateTime        @default(now()) @map("created_at")
  diperbaruiPada DateTime      @updatedAt @map("updated_at")

  kategori     PotensiKategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  album        AlbumGaleri?

  @@index([kategoriId, status, urutan])
  @@map("potensi")
}

model PotensiInfografis {
  id         String          @id @default(cuid())
  kategoriId String          @map("kategori_id")
  label      String
  nilai      Int
  satuan     String?
  urutan     Int             @default(0)

  kategori PotensiKategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)

  @@unique([kategoriId, label])
  @@index([kategoriId, urutan])
  @@map("potensi_infografis")
}

model Layanan {
  id          String   @id @default(cuid())
  slug        String   @unique
  namaLayanan String   @map("nama_layanan")
  deskripsi   String
  persyaratan String[]
  /// Larik langkah {judul, detail} — bentuknya bebas, jadi Json.
  alur        Json
  biaya       String   @default("GRATIS")
  fileTemplat String?  @map("file_templat")
  urutan      Int      @default(0)

  @@map("layanan")
}

model Pengaduan {
  id          String    @id @default(cuid())
  namaPelapor String    @map("nama_pelapor")
  kontak      String
  kategori    String
  lokasi      String?
  isi         String
  lampiranUrl String?   @map("lampiran_url")
  dibacaPada  DateTime? @map("dibaca_pada")
  dibuatPada  DateTime  @default(now()) @map("created_at")

  @@index([dibacaPada])
  @@map("pengaduan")
}

/// TIDAK DIPAKAI sejak 28 Jul 2026 — modul Transparansi Anggaran dihapus dari
/// lingkup proker (izin publikasi APBDes tidak pasti turun tepat waktu; PRD
/// menandainya "Penting", bukan "Wajib").
///
/// ponytail: tabelnya sengaja ditinggal, bukan di-drop. Menghapusnya menuntut
/// migrasi baru dan membuang data yang sudah ter-seed, sedangkan tabel kosong
/// yang menganggur tidak berbiaya apa pun saat berjalan. Kalau izinnya turun,
/// modul ini hidup lagi tanpa menyentuh skema.
model Anggaran {
  id      String        @id @default(cuid())
  tahun   Int
  jenis   JenisAnggaran
  uraian  String
  /// Rupiah. BigInt karena APBDes bisa menembus batas Int (±2,1 miliar).
  jumlah  BigInt
  catatan String?
  /// Angka contoh selama izin publikasi dari kalurahan belum turun.
  resmi   Boolean       @default(false)

  @@index([tahun, jenis])
  @@map("anggaran")
}

model StatistikPenduduk {
  id       String            @id @default(cuid())
  tahun    Int
  kategori KategoriStatistik
  label    String
  nilai    Int
  urutan   Int               @default(0)

  @@unique([tahun, kategori, label])
  @@map("statistik_penduduk")
}
