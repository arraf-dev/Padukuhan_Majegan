# Salin jadi .env.local lalu isi nilainya. Jangan commit .env.local.

# Neon Postgres — pakai connection string yang "Pooled" (ada -pooler di host).
DATABASE_URL="postgresql://pengguna:sandi@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Kunci penanda tangan cookie sesi admin. Bangkitkan sekali:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RAHASIA_SESI=""

# Akun SuperAdmin (Dukuh) yang dibuat `npx prisma db seed`.
SUPERADMIN_EMAIL="dukuh@pandowoharjo.desa.id"
SUPERADMIN_SANDI=""

# Cloudflare R2 — aset publik (sampul berita, foto perangkat, galeri, potensi).
# Buat Token API R2 dengan izin Object Read & Write untuk bucket bersangkutan.
R2_ACCOUNT_ID="account-id"
R2_ACCESS_KEY_ID="access-key-id"
R2_SECRET_ACCESS_KEY="secret-access-key"
R2_BUCKET_PUBLIK="majegan-publik"
R2_PUBLIC_URL="https://majegan-publik.<account-id>.r2.dev"

# Cloudflare R2 — bucket privat untuk lampiran pengaduan. Perlu token dengan
# akses ke bucket ini; jangan dipakai untuk aset publik.
R2_BUCKET_PRIVAT="majegan-private"

# Penanda konten publik. Gunakan "demo" sampai seluruh data telah diverifikasi.
DATA_MODE="demo"

# Alamat kanonik situs — dipakai metadata, sitemap, robots.
# WAJIB disetel identik di Vercel (Settings → Environment Variables) untuk
# Production; build production akan GAGAL bila nilainya menyimpang dari
# situs kanonik (lihat src/lib/env.ts).
NEXT_PUBLIC_URL="https://www.majegan-pandowoharjo.id"
