# Salin jadi .env.e2e lalu isi. Jangan commit .env.e2e.
# Seluruh variabel dipakai Playwright (npm run test:e2e).

# URL deployment HTTPS tujuan uji akhir (production).
E2E_URL="https://padukuhan-majegan.vercel.app"

# SuperAdmin uji — biasanya akun Dukuh dari seed. Simpan nilai aman di pengelola sandi.
E2E_SUPERADMIN_EMAIL=""
E2E_SUPERADMIN_SANDI=""

# Admin uji — dibuat otomatis oleh spec bila belum ada.
E2E_ADMIN_EMAIL="admin-e2e@pandowoharjo.desa.id"
E2E_ADMIN_SANDI=""
E2E_ADMIN_JABATAN="Admin Uji E2E"

# "true" hanya bila 7 env R2 (R2_*) sudah terisi lengkap di Vercel & bucket bisa diunggah.
E2E_UJI_UNGGAN="false"
